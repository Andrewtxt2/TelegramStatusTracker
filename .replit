modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["openssl", "pkg-config", "gcc", "libffi", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Render Bot"

[[workflows.workflow]]
name = "Deploy Bot"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Clean Start"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f python || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 2"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Start Bot"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f python || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 3"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Fixed Bot Start"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f python3 || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f app.py || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 3"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Restart Bot"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f standalone_bot.py || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 3"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 standalone_bot.py"

[[workflows.workflow]]
name = "Render Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 render_bot.py"
waitForPort = 5000

[deployment]
deploymentTarget = "gce"
run = ["sh", "-c", "python3 app.py"]

[[ports]]
localPort = 80
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000
