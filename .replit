modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["openssl"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Bot Setup"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Daemon Monitor Service"

[[workflows.workflow]]
name = "Telegram Bot Setup"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install python-telegram-bot>=20.0 aiohttp>=3.8.0 aiosqlite>=0.17.0 psutil>=5.9.0"

[[workflows.workflow]]
name = "Deploy Bot"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Clean Start"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f python || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 2"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Start Bot"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f python || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 3"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Fixed Bot Start"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f python3 || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f app.py || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 3"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Daemon Monitor Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 daemon_monitor.py"

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "python3 app.py"]

[[ports]]
localPort = 80
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000
