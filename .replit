modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["openssl"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Deploy Bot"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Clean Start"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f python || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 2"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Start Bot"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f python || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 3"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Fixed Bot Start"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f python3 || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f app.py || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 3"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[[workflows.workflow]]
name = "Restart Bot"
author = 43506130
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f standalone_bot.py || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 3"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 standalone_bot.py"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Complete Working System"

[[workflows.workflow]]
name = "Complete Working System"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 complete_working_system.py"
waitForPort = 80

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "python3 app.py"]

[[ports]]
localPort = 80
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000
